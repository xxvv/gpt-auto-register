{
  "manifest_version": 3,
  "name": "GPT Auto Register v2",
  "version": "2.0.0",
  "description": "GPT registration, PayURL, and PayPal payment automation wizard",
  "permissions": [
    "tabs",
    "storage",
    "clipboardWrite",
    "scripting",
    "activeTab",
    "proxy",
    "webRequest",
    "webRequestAuthProvider",
    "declarativeNetRequest",
    "sidePanel",
    "windows"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://proxy.webshare.io/*",
    "https://ipapi.co/*",
    "https://hero-sms.com/*",
    "https://sms.oapi.vip/*",
    "https://payment.nuo.cm/*",
    "https://scan.youyushen.icu/*",
    "https://plus.iceaix.com/*",
    "https://setup.icloud.com/*",
    "https://setup.icloud.com.cn/*",
    "https://*.icloud.com/*",
    "https://*.icloud.com.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "GPT Auto Register v2"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content-script.js",
        "content-call-runner.js",
        "us_zip3_state_ranges.json"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
